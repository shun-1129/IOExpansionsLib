<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)'=='Debug'">
        <Reference Include="IOExpansionsLib">
            <HintPath>..\..\..\bin\dll\Debug\IOExpansionsLib\IOExpansionsLib.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)'=='Release'">
        <Reference Include="IOExpansionsLib">
            <HintPath>..\..\..\bin\dll\Release\IOExpansionsLib\IOExpansionsLib.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
